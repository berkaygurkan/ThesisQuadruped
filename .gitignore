data/logs/
runs/
wandb/
configs/exported/
__pycache__/
.ipynb_checkpoints/
.venv
venv/

# Model ağırlıkları (Checkpoints)
# GitHub 100MB üstü dosyaları kabul etmez. Bunları Drive/HDD'de tut.
data/checkpoints/*.pt
data/checkpoints/*.pth
data/models/*.pt
*.ckpt

# Ancak klasör yapısı korunsun diye .gitkeep dosyalarına izin ver
!data/logs/.gitkeep
!data/checkpoints/.gitkeep

